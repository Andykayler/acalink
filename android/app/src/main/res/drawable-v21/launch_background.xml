<?xml version="1.0" encoding="utf-8"?>
<!-- Shown from the moment the app is tapped until Flutter draws its first frame:
     the Acalink tile on the app's dark background, instead of a white screen.
     The animated loader (lib/widgets/acalink_loader.dart) picks up from here. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/acalink_launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
